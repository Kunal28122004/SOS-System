# CLIENT-SIDE FIREBASE KEYS
NEXT_PUBLIC_FIREBASE_API_KEY="your-public-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"

# SERVER-SIDE FIREBASE ADMIN SDK (Service Account)
# 1. Go to Project Settings -> Service accounts in the Firebase console.
# 2. Click "Generate new private key" and save the JSON file.
# 3. Copy the contents of the JSON file and paste them here as a single-line string.
#    You can use an online tool to convert your multi-line JSON to a single line.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":...}'
